{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/format-on-stop.sh\"",
            "description": "Auto-format Kotlin via ktlint/detekt after a turn ends. No-op if neither is available."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-paths.sh\"",
            "description": "Block edits to build/, .gradle/, and generated files."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kotlin-guard.sh\"",
            "description": "Validate edited .kt files against non-negotiable forbidden patterns (!!, runBlocking, println, android.util.Log)."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/android-cli-check.sh\"",
            "description": "Optional Android CLI advisory (Android projects only; non-blocking). Self-contained in android-plugin."
          }
        ]
      }
    ]
  }
}
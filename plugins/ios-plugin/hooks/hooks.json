{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/format-on-stop.sh\"",
            "description": "Auto-format Swift via swiftformat/swiftlint after a turn ends. No-op off macOS or if tools absent."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-paths.sh\"",
            "description": "Block edits to Pods/, build/, DerivedData/."
          }
        ]
      }
    ]
  }
}

.DS_Store
*.log
docs/plans/_*.json
docs/plans/_*.log
node_modules/
docs/plans/**/.checkpoint/

# Eval run output: one report.html + aggregate-result.json per run, regenerated on every invocation.
plugins/*/evals/results/

# Benchmark run archives are large binaries; the JSON results beside them are the evidence and stay tracked.
bench/archive/*.tar.gz
bench/archive-headless/*.tar.gz
bench/campaign.log
# Local Claude state (worktrees, settings, caches) stays out of the repo. Note the `/*`: git
# will not descend into an excluded DIRECTORY, so `.claude/` + `!.claude/rules/` silently fails
# to re-include anything — the contents must be excluded instead.
.claude/*
# …the shared rule files ARE the repo's contract: CLAUDE.md @-includes them, and a clone that
# lacks them loses the rule with no error. Keep them tracked.
!.claude/rules/
!.claude/commands/
plugins/sdlc/evals/results/
